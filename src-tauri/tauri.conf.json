{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guanaco",
  "version": "0.1.0",
  "identifier": "com.antonioebarros.guanaco",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Guanaco — IA Local",
        "width": 1160,
        "height": 760,
        "minWidth": 820,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
